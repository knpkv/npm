{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.jsonc",
  "include": ["**/*.ts"],
  "exclude": ["fixtures", "node_modules"],
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "incremental": false,
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["effect", "@effect/*"],
        "diagnosticSeverity": {
          "overriddenSchemaConstructor": "off",
          "unstableApiUsage": "off",
          "strictBooleanExpressions": "suggestion",
          "strictEffectProvide": "suggestion"
        },
        "includeSuggestionsInTsc": false,
        "ignoreEffectSuggestionsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectErrorsInTscExitCode": false
      }
    ]
  }
}
