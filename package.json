{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "precommit": "tsx packages/control-center/scripts/run-precommit.ts",
    "verify:full": "pnpm format && pnpm lint && pnpm check && pnpm test",
    "skills:sync": "node scripts/sync-skills.mjs write",
    "skills:check": "node scripts/sync-skills.mjs check",
    "codegen": "pnpm --recursive --parallel --filter \"./packages/**/*\" run codegen",
    "build": "tsc -b tsconfig.build.json && pnpm --recursive --filter \"./packages/**/*\" run build",
    "audit": "pnpm audit --prod && pnpm audit --dev",
    "test": "vitest --configLoader native && pnpm test:pack",
    "test:pack": "pnpm --recursive --filter \"./packages/**/*\" --if-present run test:pack",
    "test:browser": "pnpm --workspace-concurrency=1 --recursive --filter \"./packages/**/*\" --if-present run test:browser",
    "coverage": "vitest --configLoader native --coverage",
    "check": "pnpm build && pnpm --recursive --filter \"./packages/**/*\" run check",
    "lint": "pnpm lint:config && pnpm lint:security-doc-examples && pnpm lint:live-aws && pnpm lint:eslint && pnpm lint:oxlint && pnpm lint:ast && pnpm lint:rly-colors && pnpm lint:rly-css-tokens",
    "lint:config": "node scripts/check-eslint-config.mjs && node scripts/check-ast-grep-scopes.mjs && node scripts/check-effect-tsconfig-coverage.mjs && node scripts/check-changeset-coverage.mjs && node scripts/check-workflow-action-pins.mjs && node scripts/check-workflow-secret-boundaries.mjs",
    "lint:security-doc-examples": "node scripts/check-security-doc-examples.mjs",
    "lint:live-aws": "node scripts/check-control-center-live-aws.mjs && bash infra/control-center-live-aws/bootstrap.test.sh && bash infra/control-center-live-aws/probe.test.sh",
    "lint:eslint": "pnpm lint:eslint:control-center && pnpm lint:eslint:workspace",
    "lint:eslint:control-center": "eslint --no-error-on-unmatched-pattern \"packages/control-center/{src,test,e2e}/**/*.{ts,tsx,mjs}\" \"packages/control-center/scripts/**/*.{ts,tsx}\" \"packages/control-center/{vite,vitest,vitest.live,vitest.live-aws,playwright,playwright.atlassian-oauth}.config.ts\"",
    "lint:eslint:workspace": "eslint --no-error-on-unmatched-pattern --ignore-pattern \"packages/control-center/**\" \"**/{src,test,e2e,examples,dtslint}/**/*.{ts,tsx,mjs}\" \"**/scripts/**/*.{ts,tsx}\" \"scripts/check-{control-center-live-aws,security-doc-examples}.mjs\"",
    "lint:eslint:fix": "pnpm lint:eslint:control-center --fix && pnpm lint:eslint:workspace --fix",
    "lint:oxlint": "oxlint --config oxlint.config.ts .",
    "lint:rly-colors": "pnpm --filter @knpkv/rly lint:colors",
    "lint:rly-css-tokens": "pnpm --filter @knpkv/control-center lint:rly-css-tokens",
    "lint:ast": "ast-grep test && ast-grep scan --globs '!**/generated/**'",
    "lint:fix": "pnpm lint:eslint:fix && pnpm lint:ast --update-all",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "prepare": "effect-tsgo patch --typescript && husky"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.1",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@effect/build-utils": "^0.8.9",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.87.2",
    "@effect/platform-node": "4.0.0-beta.107",
    "@effect/tsgo": "^0.36.4",
    "@effect/vitest": "4.0.0-beta.107",
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "effect": "4.0.0-beta.107",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "oxlint": "1.78.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "catalog:",
    "yaml": "2.9.0"
  }
}
