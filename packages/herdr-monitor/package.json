{
  "name": "@knpkv/herdr-monitor",
  "version": "0.0.0",
  "description": "Explicitly published, isolated read-only agent status boards",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/herdr-monitor"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./publisher": {
      "types": "./dist/publisher.d.ts",
      "import": "./dist/publisher.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "herdr-monitor": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rimraf dist && tsc -b --force && vite build",
    "check": "tsc -b",
    "lint": "eslint \"{src,test,scripts}/**/*.{ts,tsx,mjs}\"",
    "test": "vitest run",
    "test:pack": "node scripts/packed.mjs"
  },
  "dependencies": {
    "effect": "4.0.0-rc.109",
    "@effect/platform-node": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@knpkv/rly": "workspace:^",
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.2.1",
    "vitest": "catalog:",
    "happy-dom": "20.11.2"
  }
}
