{
  "name": "@knpkv/jira-clockify",
  "version": "1.1.5",
  "description": "TUI for Jira-Clockify time tracking, attachable to neovim",
  "license": "MIT",
  "author": "knpkv",
  "type": "module",
  "bin": {
    "jcf": "dist/src/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "nvim",
    "!nvim/test",
    "skills"
  ],
  "scripts": {
    "start": "tsx src/bin.ts",
    "build": "tsc -b && chmod +x dist/src/bin.js",
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-beta.98",
    "@effect/platform-node": "4.0.0-beta.98",
    "@knpkv/agent-skills": "workspace:^",
    "@knpkv/atlassian-common": "workspace:^",
    "@knpkv/clockify-api-client": "workspace:^",
    "@knpkv/jira-api-client": "workspace:^",
    "@knpkv/jira-cli": "workspace:^",
    "@opentui/core": "0.5.1",
    "@opentui/react": "0.5.1",
    "effect": "4.0.0-beta.98",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.98",
    "@types/node": "latest",
    "@types/react": "^19.2.17",
    "tsx": "^4.23.0",
    "vitest": "^4.1.10"
  }
}
