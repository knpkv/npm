{
  "name": "@knpkv/jira-clockify",
  "version": "1.5.0",
  "description": "TUI for Jira-Clockify time tracking, attachable to neovim",
  "license": "MIT",
  "author": "knpkv",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./testing.js": {
      "types": "./src/testing/fakeHeadless.ts",
      "default": "./dist/src/testing/fakeHeadless.js"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "bin": {
    "jcf": "dist/src/bin.js"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./testing.js": {
        "types": "./dist/src/testing/fakeHeadless.d.ts",
        "default": "./dist/src/testing/fakeHeadless.js"
      },
      "./*.js": {
        "types": "./dist/src/*.d.ts",
        "default": "./dist/src/*.js"
      }
    }
  },
  "files": [
    "dist",
    "nvim",
    "!nvim/test",
    "skills"
  ],
  "scripts": {
    "start": "tsx src/bin.ts",
    "build": "tsc -b && chmod +x dist/src/bin.js",
    "check": "tsc -b tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@knpkv/agent-skills": "workspace:^",
    "@knpkv/ai-claude": "workspace:^",
    "@knpkv/ai-codex": "workspace:^",
    "@knpkv/atlassian-common": "workspace:^",
    "@knpkv/clockify-api-client": "workspace:^",
    "@knpkv/jira-api-client": "workspace:^",
    "@knpkv/jira-cli": "workspace:^",
    "@opentui/core": "0.5.14",
    "@opentui/react": "0.5.14",
    "effect": "4.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "vitest": "catalog:"
  }
}
