{
  "name": "@knpkv/ai-runtime",
  "version": "0.4.0",
  "description": "Provider-neutral Effect runtime protocol for durable local AI agents",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/ai-runtime"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rimraf dist && tsc -b --force",
    "check": "tsc --noEmit && pnpm check:contract",
    "check:contract": "sh -c '../../node_modules/.bin/tsc -p tsconfig.contract.json && ../../node_modules/.bin/tsc6 -p tsconfig.contract-fixture.json && rimraf tsconfig.contract-invalid.tsbuildinfo && ! ../../node_modules/.bin/tsc -p tsconfig.contract-invalid.json'",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"{src,test,dtslint}/**/*.ts\"",
    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "effect": "4.0.0-rc.109",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "keywords": [
    "effect",
    "agent",
    "runtime",
    "codex",
    "claude"
  ]
}
