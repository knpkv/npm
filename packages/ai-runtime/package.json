{
  "name": "@knpkv/ai-runtime",
  "version": "0.5.2",
  "description": "Provider-neutral Effect runtime protocol for durable local AI agents",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/ai-runtime"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rimraf dist && tsc -b --force",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.contract.json && tsc6 -p tsconfig.contract-fixture.json && pnpm check:contract-invalid",
    "check:contract-invalid": "node scripts/check-invalid-contract.mjs && node --test scripts/check-invalid-contract.test.mjs",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"{src,test,dtslint}/**/*.ts\"",
    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "effect": "4.0.0",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "keywords": [
    "effect",
    "agent",
    "runtime",
    "codex",
    "claude"
  ],
  "dependencies": {
    "@knpkv/bounded-io": "workspace:^"
  }
}
