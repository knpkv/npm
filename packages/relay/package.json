{
  "name": "@knpkv/relay",
  "version": "0.1.0",
  "description": "Relay agent harness: durable sessions per product object, typed capabilities, a central permission gate, and model turns through the user's own Claude Code or Codex CLI login",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/relay"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-THIRD-PARTY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/bundle.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:pack": "pnpm --filter \"@knpkv/relay...\" --sort run build && node scripts/test-packed-package.mjs"
  },
  "peerDependencies": {
    "effect": "4.0.0"
  },
  "dependencies": {
    "@knpkv/ai-claude": "workspace:^",
    "@knpkv/ai-codex": "workspace:^",
    "@knpkv/ai-runtime": "workspace:^",
    "@knpkv/capability": "workspace:^",
    "@libsql/client": "^0.18.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "effect": "4.0.0",
    "esbuild": "0.28.2",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "keywords": [
    "effect",
    "agent",
    "relay",
    "durable",
    "claude",
    "codex"
  ]
}
