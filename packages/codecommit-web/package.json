{
  "name": "@knpkv/codecommit-web",
  "version": "0.14.0",
  "description": "Web server and frontend for CodeCommit PR browser",
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/dts/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "CODECOMMIT_WEB_PUBLIC_ORIGIN=http://localhost:5173 bun run --watch src/main.ts & vite --clearScreen false",
    "prepack": "tsc -b && vite build",
    "build": "tsc -b && vite build",
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "test:relay-smoke:real": "vitest run --config vitest.real-smoke.config.ts",
    "test:browser": "pnpm --filter \"@knpkv/relay-product...\" build && pnpm --filter \"@knpkv/review...\" build && pnpm build && playwright test --config playwright.config.ts",
    "lint": "eslint \"{src,test,e2e}/**/*.{ts,tsx}\" playwright.config.ts",
    "docgen": "docgen"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-rc.109",
    "@effect/platform-bun": "4.0.0-rc.109",
    "@effect/platform-node": "4.0.0-rc.109",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@knpkv/ai-codex": "workspace:^",
    "@knpkv/codecommit-core": "workspace:^",
    "@knpkv/review": "workspace:^",
    "@knpkv/relay-product": "workspace:^",
    "@knpkv/rly": "workspace:^",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "9.0.0",
    "effect": "4.0.0-rc.109",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@playwright/test": "1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.1",
    "vitest": "catalog:"
  }
}
