{
  "name": "@knpkv/rly",
  "version": "0.2.0",
  "description": "Release-oriented design system for human and agent collaboration",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/rly"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/dts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dts/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diff": {
      "types": "./dist/dts/diff/index.d.ts",
      "import": "./dist/diff/index.js"
    },
    "./diff/bounded": {
      "types": "./dist/dts/diff/bounded/index.d.ts",
      "import": "./dist/diff/bounded/index.js"
    },
    "./diff/workbench": {
      "types": "./dist/dts/diff/workbench/index.d.ts",
      "import": "./dist/diff/workbench/index.js"
    },
    "./foundations": {
      "types": "./dist/dts/foundations/index.d.ts",
      "import": "./dist/foundations/index.js"
    },
    "./patterns": {
      "types": "./dist/dts/patterns/index.d.ts",
      "import": "./dist/patterns/index.js"
    },
    "./primitives": {
      "types": "./dist/dts/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./tokens": {
      "types": "./dist/dts/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./registry/components.json": "./registry/components.json",
    "./registry/schema.json": "./registry/schema.json",
    "./registry/search.json": "./registry/search.json",
    "./registry/USAGE.md": "./registry/USAGE.md",
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "registry",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "scripts": {
    "build": "pnpm codegen:check && pnpm validate:registry && rimraf dist && vite build && vite build --config vite.bounded.config.ts && tsx scripts/build-assets.ts && tsc -b tsconfig.build.json --force && pnpm validate:dist",
    "check": "pnpm codegen:check && pnpm validate:registry && pnpm lint:colors && tsc -b tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo",
    "codegen": "tsx scripts/generate-contract.ts write",
    "codegen:check": "tsx scripts/generate-contract.ts check",
    "lint": "eslint \"{src,test,scripts,generated,manifest,stories,visual,.storybook}/**/*.{ts,tsx}\" component-manifest.ts vite.config.ts vite.bounded.config.ts vitest.config.ts vitest.storybook.config.ts playwright.config.ts && pnpm lint:colors",
    "lint:colors": "tsx scripts/tokens/lint-colors.ts",
    "prepack": "pnpm build",
    "scaffold": "tsx scripts/scaffold-component.ts",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --exact-port --no-open --no-version-updates",
    "storybook:build": "NODE_OPTIONS=--disable-warning=DEP0205 storybook build --output-dir storybook-static --disable-telemetry && pnpm validate:storybook",
    "storybook:serve": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6006 --strictPort",
    "test": "vitest run",
    "test:browser": "pnpm test:storybook && pnpm test:visual",
    "test:pack": "tsx scripts/test-packed-package.ts",
    "test:storybook": "vitest run --config vitest.storybook.config.ts --project storybook",
    "test:visual": "pnpm storybook:build && playwright test --config playwright.config.ts",
    "validate:dist": "tsx scripts/validate-dist.ts",
    "validate:registry": "tsx scripts/validate-registry.ts",
    "validate:storybook": "tsx scripts/validate-storybook.ts",
    "visual:classify": "tsx scripts/visual/classify-git-changes.ts"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@effect/vitest": "4.0.0-rc.109",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "ajv": "8.20.0",
    "effect": "4.0.0-rc.109",
    "happy-dom": "20.11.2",
    "playwright": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "storybook": "10.5.8",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.1",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@pierre/diffs": "1.3.5",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7"
  }
}
