{
  "name": "@knpkv/relay-product",
  "version": "0.1.0",
  "description": "Shared Relay product dock and typed product adapter",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/relay-product"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conversation": {
      "types": "./dist/conversation.d.ts",
      "import": "./dist/conversation.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -b --force",
    "check": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\" vitest.config.ts",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@knpkv/rly": "workspace:^"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.109",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@knpkv/rly": "workspace:^",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "effect": "4.0.0-rc.109",
    "happy-dom": "20.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  }
}
