{
  "name": "@knpkv/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm build:catalog && astro build && pnpm compose:catalog && pnpm validate",
    "build:catalog": "pnpm --filter @knpkv/rly storybook:build",
    "compose:catalog": "node scripts/compose-rly-catalog.mjs",
    "preview": "astro preview",
    "check": "astro check && pnpm validate:source",
    "validate": "pnpm validate:rly && pnpm validate:control-center",
    "validate:source": "pnpm validate:rly:source && pnpm validate:control-center:source",
    "validate:control-center": "node scripts/release-gate-evidence-fixtures.mjs && node scripts/validate-control-center-docs.mjs",
    "validate:control-center:release": "node scripts/validate-control-center-docs.mjs --release-gate",
    "validate:control-center:source": "node scripts/validate-control-center-docs.mjs --source-only",
    "validate:rly": "node scripts/validate-rly-docs.mjs",
    "validate:rly:source": "node scripts/validate-rly-docs.mjs --source-only",
    "clean": "rimraf dist .astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/starlight": "^0.41.7",
    "astro": "7.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
