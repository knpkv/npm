{
  "name": "@knpkv/herdr-usage",
  "version": "0.1.0",
  "description": "Claude and Codex usage and limits across the fleet, as a Relay hub app that also runs on its own",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/herdr-usage"
  },
  "type": "module",
  "sideEffects": [
    "./dist/bin.js"
  ],
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./selection": {
      "types": "./dist/selection.d.ts",
      "import": "./dist/selection.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js"
    },
    "./views.css": "./dist/views/views.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force && node scripts/build-client.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@knpkv/agent-usage": "workspace:^",
    "@knpkv/bounded-io": "workspace:^",
    "@knpkv/herdr-connect": "workspace:^",
    "@knpkv/herdr-fleet": "workspace:^",
    "@knpkv/hub-app": "workspace:^"
  },
  "peerDependencies": {
    "@knpkv/rly": "workspace:^",
    "effect": "4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@knpkv/browser-pairing": "workspace:^",
    "@knpkv/rly": "workspace:^",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "effect": "4.0.0",
    "esbuild": "0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "bin": {
    "herdr-usage": "./dist/bin.js"
  },
  "hubApp": {
    "bin": "dist/bin.js",
    "contract": 1,
    "services": [
      "fleet.read",
      "host"
    ]
  }
}
