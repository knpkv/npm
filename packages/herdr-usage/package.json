{
  "name": "@knpkv/herdr-usage",
  "version": "0.0.0",
  "description": "Claude and Codex usage and limits across the fleet, as a Relay hub app that also runs on its own",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/herdr-usage"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@knpkv/bounded-io": "workspace:^",
    "@knpkv/herdr-connect": "workspace:^",
    "@knpkv/hub-app": "workspace:^"
  },
  "peerDependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "^26.6.4",
    "effect": "4.0.0",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  }
}
