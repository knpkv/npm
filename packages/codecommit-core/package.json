{
  "name": "@knpkv/codecommit-core",
  "version": "0.20.0",
  "description": "Core logic for CodeCommit PR browser",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./Domain.js": "./src/Domain.ts",
    "./CacheService.js": "./src/CacheService/index.ts",
    "./ConfigService.js": "./src/ConfigService/index.ts",
    "./ReadClient.js": "./src/ReadClient/index.ts",
    "./ReviewClient.js": "./src/ReviewClient/index.ts",
    "./RelayCapabilities.js": "./src/RelayCapabilities/index.ts",
    "./SandboxService.js": "./src/SandboxService/index.ts",
    "./*.js": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/dts/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./ConfigService.js": "./dist/ConfigService/index.js",
      "./ReadClient.js": "./dist/ReadClient/index.js",
      "./ReviewClient.js": "./dist/ReviewClient/index.js",
      "./RelayCapabilities.js": "./dist/RelayCapabilities/index.js",
      "./*.js": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "tsc",
    "build": "tsc",
    "check": "tsc -b tsconfig.json && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest",
    "test:pack": "tsx scripts/test-packed-package.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "docgen": "docgen"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1145.0",
    "@distilled.cloud/aws": "1.0.0-rc.13",
    "@effect/sql-libsql": "4.0.0",
    "@knpkv/capability": "workspace:^",
    "@libsql/client": "^0.18.0",
    "@smithy/core": "^3.35.1",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@types/node": "26.6.4"
  }
}
