{
  "name": "@knpkv/control-center",
  "version": "0.8.0",
  "description": "Human- and agent-oriented delivery control center",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/control-center"
  },
  "type": "module",
  "bin": {
    "control-center": "./dist/server/server/cli.js"
  },
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./api": {
      "types": "./dist/server/api/index.d.ts",
      "import": "./dist/server/api/index.js"
    },
    "./domain": {
      "types": "./dist/server/domain/index.d.ts",
      "import": "./dist/server/domain/index.js"
    },
    "./server": {
      "types": "./dist/server/server/index.d.ts",
      "import": "./dist/server/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "benchmark": "pnpm benchmark:contracts && pnpm benchmark:runtime",
    "benchmark:contracts": "tsx scripts/runBenchmark.ts",
    "benchmark:runtime": "pnpm build && pnpm benchmark:runtime:prepared",
    "benchmark:runtime:prepared": "rimraf test-results/control-center/runtime-benchmark.json && CONTROL_CENTER_RUNTIME_BENCHMARK_OUTPUT=test-results/control-center/runtime-benchmark.json playwright test e2e/real-runtime.spec.ts --grep \"measures warmed\" --config playwright.config.ts && pnpm benchmark:validate-runtime",
    "benchmark:validate-runtime": "CONTROL_CENTER_RUNTIME_BENCHMARK_OUTPUT=test-results/control-center/runtime-benchmark.json tsx scripts/validateRuntimeBenchmarkReport.ts",
    "build": "tsx scripts/run-build.ts",
    "check": "pnpm validate:boundaries && pnpm lint:rly-css-tokens && tsc -b tsconfig.json && tsc -p tsconfig.roles.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo node_modules/.cache",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "lint": "eslint \"{src,test,e2e,scripts}/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts vitest.live.config.ts vitest.live-aws.config.ts playwright.config.ts playwright.atlassian-oauth.config.ts && pnpm lint:rly-css-tokens",
    "lint:rly-css-tokens": "tsx scripts/validateRlyCssTokens.ts",
    "preview": "vite preview --outDir dist/client --host 127.0.0.1 --port 4173 --strictPort",
    "start": "node ./dist/server/server/cli.js",
    "pretest": "pnpm --filter @knpkv/browser-pairing build",
    "test": "vitest run",
    "test:browser": "pnpm test:e2e",
    "test:e2e": "pnpm build && rimraf test-results/control-center/runtime-benchmark.json && playwright test --config playwright.config.ts",
    "test:e2e:atlassian-oauth": "CONTROL_CENTER_TEST_ATLASSIAN_OAUTH=1 pnpm build && CONTROL_CENTER_TEST_ATLASSIAN_OAUTH=1 playwright test e2e/atlassian-oauth.spec.ts --config playwright.atlassian-oauth.config.ts",
    "test:integration:live-aws": "pnpm build && vitest run --config vitest.live-aws.config.ts",
    "test:integration:live": "pnpm build && vitest run --config vitest.live.config.ts",
    "test:pack": "tsx scripts/test-packed-package.ts",
    "test:sbx:real": "vitest run --config vitest.sbx.config.ts",
    "validate:boundaries": "tsx scripts/validate-boundaries.ts",
    "validate:dist": "tsx scripts/validate-dist.ts"
  },
  "dependencies": {
    "@aws-sdk/client-codepipeline": "^3.1108.0",
    "@aws-sdk/credential-providers": "^3.1108.0",
    "@distilled.cloud/aws": "1.0.0-rc.4",
    "@effect/ai-openai-compat": "4.0.0-rc.109",
    "@effect/platform-browser": "4.0.0-rc.109",
    "@effect/platform-node": "4.0.0-rc.109",
    "@effect/sql-libsql": "4.0.0-rc.109",
    "@knpkv/ai-claude": "workspace:^",
    "@knpkv/ai-codex": "workspace:^",
    "@knpkv/ai-runtime": "workspace:^",
    "@knpkv/atlassian-common": "workspace:^",
    "@knpkv/browser-pairing": "workspace:^",
    "@knpkv/clockify-api-client": "workspace:^",
    "@knpkv/codecommit-core": "workspace:^",
    "@knpkv/confluence-api-client": "workspace:^",
    "@knpkv/confluence-to-markdown": "workspace:^",
    "@knpkv/control-center-sql": "workspace:^",
    "@knpkv/jira-api-client": "workspace:^",
    "@knpkv/review": "workspace:^",
    "@knpkv/relay-product": "workspace:^",
    "@knpkv/rly": "workspace:^",
    "effect": "4.0.0-rc.109",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "4.13.0",
    "fast-check": "^4.9.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.1",
    "vitest": "catalog:"
  }
}
