{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.jsonc",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/views-types",
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.views.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": [
    "src/views.ts",
    "src/api",
    "src/domain",
    "src/client/entities/WorkspaceIssueDetails.tsx",
    "src/client/entities/WorkspacePipelineExecutionDetails.tsx",
    "src/client/entities/WorkspaceClockifyTimeEntryDetails.tsx",
    "src/client/entities/WorkspaceRichText.tsx",
    "src/client/services/ConnectionTestEvidence.tsx",
    "src/client/settings/ReleaseTargetsEditor.tsx",
    "src/client/entities/ReviewSuggestionPresentation.tsx",
    "src/client/entities/ReviewSuggestionOverview.tsx",
    "src/client/entities/ReviewSuggestionRevisionHistory.tsx",
    "src/client/entities/ReviewSuggestionRevisionDialog.tsx",
    "src/client/entities/ReviewSuggestionPublicationSurface.tsx",
    "src/client/portfolio/PortfolioOverviewView.tsx",
    "src/client/releases/RelationshipRepairPanelView.tsx",
    "src/client/settings/SettingsForm.tsx",
    "src/client/releases/ReleaseEvidence.tsx",
    "src/client/BrowserSessionStatusView.tsx",
    "src/client/services/ConnectionSynchronizationView.tsx",
    "src/client/portfolio/portfolioFilters.ts",
    "src/client/formatTime.ts",
    "src/client/portfolio/presentPortfolio.ts",
    "src/client/portfolio/livePortfolioState.ts",
    "src/client/services/serviceOnboarding.ts",
    "src/client/services/connectionState.ts",
    "src/client/services/syncPresentation.ts",
    "src/client/settings/releaseTargetErrorMessage.ts",
    "src/client/entities/presentWorkspaceClockifyTimeEntry.ts",
    "src/client/entities/presentWorkspaceIssue.ts",
    "src/client/entities/presentWorkspacePipelineExecution.ts",
    "src/client/workspaceEntityPaths.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
