    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "^26.6.4",
    "effect": "4.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/credential-provider-sso": "^3.973.16",
    "@distilled.cloud/aws": "^1.0.0-rc.13",
    "@knpkv/bounded-io": "workspace:^",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  }
}
