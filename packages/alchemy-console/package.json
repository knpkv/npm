{
  "name": "@knpkv/alchemy-console",
  "version": "0.6.1",
  "description": "Read-only discovery and state readers for local Alchemy stacks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/alchemy-console"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "alchemy-console": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./host/server": {
      "types": "./dist/host-server.d.ts",
      "import": "./dist/host-server.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views/index.js"
    },
    "./views/style.css": "./dist/views/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force && vite build && vite build -c vite.views.config.ts",
    "check": "tsc -b tsconfig.json && tsc -p test/tsconfig.json --noEmit && tsc -p test/consumer/tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:browser": "pnpm --filter '@knpkv/alchemy-console^...' build && pnpm build && playwright test"
  },
  "peerDependencies": {
    "@knpkv/rly": "workspace:^",
    "effect": "4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@knpkv/rly": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@knpkv/rly": "workspace:^",
    "esbuild": "^0.28.2",
    "@effect/vitest": "4.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "effect": "4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@aws-sdk/credential-provider-sso": "^3.973.16",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@distilled.cloud/aws": "^1.0.0-rc.13",
    "@knpkv/bounded-io": "workspace:^",
    "@knpkv/browser-pairing": "workspace:^",
    "yaml": "^2.9.1"
  }
}
