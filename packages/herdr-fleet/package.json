{
  "name": "@knpkv/herdr-fleet",
  "version": "0.3.0",
  "description": "Typed job protocol and local authority runtime for Herdr fleets",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/herdr-fleet"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./response": {
      "types": "./dist/response.d.ts",
      "import": "./dist/response.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rimraf dist && tsc -b --force",
    "check": "tsc -b tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "pack:deterministic": "pnpm build && node ../../scripts/pack-herdr.mjs .",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@effect/vitest": "4.0.0-rc.109",
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  }
}
