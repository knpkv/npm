{
  "name": "@knpkv/agent-usage",
  "version": "0.5.6",
  "description": "Claude and Codex subscription usage over time, per ticket and against limits, in a local browser view",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/agent-usage"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "bin": {
    "agent-usage": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*.js": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -b && vite build",
    "prepack": "tsc -b && vite build",
    "check": "tsc -b tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p stories/tsconfig.json",
    "test": "vitest",
    "lint": "eslint \"{src,test,stories,.storybook}/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts playwright.config.ts",
    "dev": "AGENT_USAGE_PUBLIC_ORIGIN=http://localhost:5173 tsx watch src/main.ts serve & vite --clearScreen false",
    "test:browser": "pnpm test:storybook && vite build && playwright test",
    "storybook:deps": "pnpm --filter '@knpkv/agent-usage^...' --sort run build",
    "storybook": "pnpm storybook:deps && storybook dev --host 127.0.0.1 --port 6007 --exact-port --no-open --no-version-updates",
    "test:storybook": "pnpm storybook:deps && vitest run --config vitest.storybook.config.ts --project storybook"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/sql-sqlite-node": "4.0.0",
    "@knpkv/browser-pairing": "workspace:^",
    "@knpkv/rly": "workspace:^",
    "effect": "4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@knpkv/storybook-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "storybook": "10.6.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vitest": "catalog:"
  }
}
