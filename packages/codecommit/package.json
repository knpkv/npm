{
  "name": "@knpkv/codecommit",
  "version": "0.9.0",
  "description": "TUI for browsing AWS CodeCommit PRs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/dts/index.d.ts",
  "bin": {
    "codecommit": "dist/src/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "start": "bun src/bin.ts",
    "start:web": "bun src/bin.ts web",
    "prepack": "tsc -b",
    "build": "tsc -b",
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\"",
    "docgen": "docgen"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-beta.107",
    "@effect/platform-bun": "4.0.0-beta.107",
    "@effect/platform-node": "4.0.0-beta.107",
    "@knpkv/agent-skills": "workspace:^",
    "@knpkv/ai-codex": "workspace:^",
    "@knpkv/codecommit-core": "workspace:^",
    "@knpkv/codecommit-web": "workspace:^",
    "@opentui/core": "0.5.1",
    "@opentui/react": "0.5.1",
    "diff": "9.0.0",
    "effect": "4.0.0-beta.107",
    "react": "^19.2.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.107",
    "@storybook/react": "^10.5.7",
    "@types/bun": "^1.3.14",
    "@types/node": "latest",
    "@types/react": "^19.2.18",
    "storybook": "^10.5.7",
    "vitest": "catalog:"
  }
}
