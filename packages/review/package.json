{
  "name": "@knpkv/review",
  "version": "0.2.1",
  "description": "Provider-neutral review contracts, runtime state, and controls",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/review"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./guide": {
      "types": "./dist/guide/index.d.ts",
      "import": "./dist/guide/index.js"
    },
    "./guide/react": {
      "types": "./dist/guide/view.d.ts",
      "import": "./dist/guide/view.js"
    },
    "./guide/export": {
      "types": "./dist/guide/export.d.ts",
      "import": "./dist/guide/export.js"
    },
    "./guide/styles.css": "./dist/guide/style.css"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "example:guide": "pnpm build && tsx scripts/example-guide.ts",
    "build": "rimraf dist && tsc -b --force && tsx scripts/build-guide-assets.ts",
    "check": "tsc -b tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"{src,test,scripts}/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "pretest": "pnpm --filter @knpkv/review... build"
  },
  "dependencies": {
    "@knpkv/rly": "workspace:^",
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@effect/vitest": "4.0.0-rc.109",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "happy-dom": "20.11.2",
    "mermaid": "^11.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
