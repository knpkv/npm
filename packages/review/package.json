{
  "name": "@knpkv/review",
  "version": "0.3.3",
  "description": "Provider-neutral review contracts, runtime state, and controls",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/review"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./guide": {
      "types": "./dist/guide/index.d.ts",
      "import": "./dist/guide/index.js"
    },
    "./guide/react": {
      "types": "./dist/guide/view.d.ts",
      "import": "./dist/guide/view.js"
    },
    "./guide/export": {
      "types": "./dist/guide/export.d.ts",
      "import": "./dist/guide/export.js"
    },
    "./guide/diagrams": {
      "types": "./dist/guide/diagrams.d.ts",
      "import": "./dist/guide/diagrams.js"
    },
    "./guide/styles.css": "./dist/guide/style.css"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "example:guide": "pnpm build && tsx scripts/example-guide.ts",
    "build": "rimraf dist && tsc -b --force && tsx scripts/build-guide-assets.ts",
    "check": "tsc -b tsconfig.json && tsc -p test/tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"{src,test,scripts}/**/*.{ts,tsx}\" playwright.config.ts",
    "test": "vitest run",
    "pretest": "pnpm --filter @knpkv/review... build",
    "test:browser": "pnpm --filter '@knpkv/review^...' --sort run build && pnpm build && playwright test"
  },
  "dependencies": {
    "@knpkv/rly": "workspace:^",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "20.14.5",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
