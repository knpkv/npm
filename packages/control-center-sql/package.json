{
  "name": "@knpkv/control-center-sql",
  "version": "0.4.0",
  "description": "Typed SQL plans for Control Center persistence",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/control-center-sql"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rimraf dist && tsc -b --force",
    "check": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "effect-qb": "0.22.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "effect": "4.0.0-rc.109",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  }
}
