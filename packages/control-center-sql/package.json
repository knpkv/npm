{
  "name": "@knpkv/control-center-sql",
  "version": "0.4.0",
  "description": "Typed SQL plans for Control Center persistence",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/control-center-sql"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rimraf dist && tsc -b --force && tsx scripts/vendor-effect-qb.ts",
    "check": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:pack": "tsx scripts/test-packed-package.ts"
  },
  "dependencies": {
    "pgsql-ast-parser": "^12.0.2"
  },
  "peerDependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "^26.6.4",
    "effect": "4.0.0",
    "effect-qb": "0.22.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  }
}
