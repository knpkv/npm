{
  "name": "@knpkv/browser-pairing",
  "version": "0.1.0",
  "description": "Typed browser pairing credentials and transport primitives",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/browser-pairing"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.roles.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@types/node": "^26.2.0",
    "effect": "4.0.0-rc.109",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  }
}
