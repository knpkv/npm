{
  "name": "@knpkv/jcf-web",
  "version": "0.6.6",
  "description": "Week view over Jira and Clockify that fills the gaps a Coding Agent's sessions evidence",
  "license": "MIT",
  "author": "knpkv",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "bin": {
    "jcf-web": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*.js": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsc -b ../jira-clockify && node ../../scripts/require-built.mjs @knpkv/jira-clockify && node dist/main.js",
    "dev": "tsc -b ../jira-clockify && node ../../scripts/require-built.mjs @knpkv/jira-clockify && (tsc -b ../jira-clockify --watch --preserveWatchOutput & JCF_WEB_PUBLIC_ORIGIN=http://localhost:5173 tsx watch src/main.ts & vite --clearScreen false)",
    "build": "tsc -b && vite build",
    "prepack": "tsc -b && vite build",
    "check": "tsc -b tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest",
    "test:pack": "tsx scripts/test-packed-package.ts && tsx scripts/test-workspace-start.ts",
    "lint": "eslint \"{scripts,src,test}/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts playwright.config.ts",
    "test:browser": "pnpm --filter '@knpkv/jcf-web^...' --sort run build && vite build && playwright test"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@knpkv/browser-pairing": "workspace:^",
    "@knpkv/jira-clockify": "workspace:^",
    "@knpkv/rly": "workspace:^",
    "effect": "4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vitest": "catalog:"
  }
}
