{
  "extends": "../../tsconfig.base.jsonc",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "declaration": true,
    "declarationMap": false,
    "composite": false,
    "jsx": "react-jsx",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "test"]
}
