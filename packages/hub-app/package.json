{
  "name": "@knpkv/hub-app",
  "version": "0.0.0",
  "description": "Contract and runner for apps that run standalone on their own port and mount in the Relay hub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/hub-app"
  },
  "type": "module",
  "sideEffects": [
    "./dist/standalone.js",
    "./dist/standalone-shell.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./hub-client": {
      "types": "./dist/hub-client.d.ts",
      "import": "./dist/hub-client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force && node scripts/build-shell.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@knpkv/browser-pairing": "workspace:^"
  },
  "peerDependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "^26.6.4",
    "effect": "4.0.0",
    "esbuild": "0.28.2",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  }
}
