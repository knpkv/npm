{
  "name": "@knpkv/herdr-hub",
  "version": "0.44.1",
  "description": "Authenticated fleet approvals, PWA, coordinator, and hostd runtime",
  "license": "MIT",
  "author": "knpkv",
  "repository": {
    "type": "git",
    "url": "https://github.com/knpkv/npm.git",
    "directory": "packages/herdr-hub"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/*.css",
    "./dist/bin.js",
    "./dist/fleetctl.js",
    "./dist/relay.js"
  ],
  "bin": {
    "hostd": "./dist/bin.js",
    "fleetctl": "./dist/fleetctl.js",
    "relay": "./dist/relay.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js"
    },
    "./fleetctl": {
      "types": "./dist/fleetctl.d.ts",
      "import": "./dist/fleetctl.js"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "import": "./dist/relay.js"
    },
    "./hostd": {
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js"
    },
    "./hostd-runtime": {
      "types": "./dist/hostd.d.ts",
      "import": "./dist/hostd.js"
    },
    "./modules": {
      "types": "./dist/modules.d.ts",
      "import": "./dist/modules.js"
    },
    "./modules/server": {
      "types": "./dist/module-server.d.ts",
      "import": "./dist/module-server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rimraf dist && tsc -b --force && node scripts/build-assets.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.worker.json --noEmit && tsc -p scripts/tsconfig.json && tsc -p test/tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\"",
    "pack:deterministic": "pnpm build && node ../../scripts/pack-herdr.mjs .",
    "test": "vitest run",
    "test:browser:superapp": "playwright test --config playwright.superapp.config.ts",
    "test:pack": "tsx scripts/test-packed-packages.ts",
    "render:icons": "tsx scripts/render-icons.ts",
    "test:browser": "pnpm --filter \"@knpkv/herdr-hub^...\" --sort run build && playwright test --config playwright.config.ts && pnpm run build && pnpm run test:browser:superapp"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0",
    "@effect/platform-browser": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@knpkv/alchemy-console": "workspace:^",
    "@knpkv/bounded-io": "workspace:^",
    "@knpkv/browser-pairing": "workspace:^",
    "@knpkv/capability": "workspace:^",
    "@knpkv/herdr-connect": "workspace:^",
    "@knpkv/herdr-coordinator": "workspace:^",
    "@knpkv/herdr-fleet": "workspace:^",
    "@knpkv/herdr-tailscale": "workspace:^",
    "@knpkv/herdr-work": "workspace:^",
    "@knpkv/relay": "workspace:^",
    "@knpkv/relay-product": "workspace:^",
    "@knpkv/review": "workspace:^",
    "@knpkv/rly": "workspace:^",
    "@knpkv/sandbox-pool": "workspace:^",
    "effect": "4.0.0",
    "web-push": "3.6.7",
    "ws": "8.22.0",
    "@knpkv/codecommit-web": "workspace:^"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@knpkv/ai-runtime": "workspace:^",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:",
    "@knpkv/design-conformance": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
